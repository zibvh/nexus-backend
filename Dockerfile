FROM node:18-slim# Install yt-dlp and ffmpegRUN apt-get update && apt-get install -y \    python3 \    python3-pip \    ffmpeg \    && pip3 install yt-dlp --break-system-packages \    && apt-get clean \    && rm -rf /var/lib/apt/lists/*WORKDIR /appCOPY package*.json ./RUN npm installCOPY . .EXPOSE 3000CMD ["npm", "start"]